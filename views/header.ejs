<link rel="stylesheet" href="/style.css" />
<header class="header">
  <!-- ハンバーガーボタン（スマホ用） -->
  <h3 class="logo">予約管理</h3>
  <p><%= users.name %>のページ</p>
  <div class="hamburger" id="hamburger">
    <% if (users.role !== "admin" && typeof hasNewCoupons !== 'undefined' && hasNewCoupons) { %>
      <div class="hamburger-new-dot"></div>
    <% } %>
    <span></span>
    <span></span>
    <span></span>
  </div>

  <nav class="nav" id="nav">
    <ul>
      <% if (users.role === "admin") { %>
      <li><a href="/adminTop">管理者トップ</a></li>
      <li><a href="/salesManagement">売上確認</a></li>
      <li><a href="/adminCoupons">クーポン設定</a></li>
      <li><a href="/adminNews">お知らせ設定</a></li>
      <li><a href="/adminCharge">チャージ額調整</a></li>
      <% } else { %>
      <li><a href="/top">トップ</a></li>
      <li class="mobileOnly"><a href="/letterBox">レターボックス</a></li>
      <li class="mobileOnly"><a href="/reservationPage">予約一覧</a></li>
      <li><a href="/charge">チャージ</a></li>
      <li class="coupon-menu-item">
        <a href="/coupons" class="coupon-link">
          クーポン
          <% if (typeof hasNewCoupons !== 'undefined' && hasNewCoupons) { %>
            <span class="header-new-badge">NEW!</span>
          <% } %>
        </a>
      </li>
      <% } %>
      <li><a href="/">ログアウト</a></li>
    </ul>
  </nav>
</header>
