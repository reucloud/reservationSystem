<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <title>予約管理システム</title>
    <!-- レスポンシブ対応用 -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, user-scalable=no"
    />
    <link rel="stylesheet" href="/public/style.css" />
  </head>
  <body>
    <!-- パスワードをお忘れの方への写真 -->
    <%- include("header") %>
    <div class="userAllWrapper" id="userAllWrapper">
      <div class="time">
        <h2>予約画面</h2>
        <div class="time-right">
          <h4>
            <%= (() => { const d = new Date(users.updated_at); const yyyy =
            d.getFullYear(); const mm = String(d.getMonth() + 1).padStart(2,
            '0'); const dd = String(d.getDate()).padStart(2, '0'); const hh =
            String(d.getHours()).padStart(2, '0'); const mi =
            String(d.getMinutes()).padStart(2, '0'); const ss =
            String(d.getSeconds()).padStart(2, '0'); return `${yyyy}/${mm}/${dd}
            ${hh}:${mi}:${ss}`; })() %> 時点
          </h4>
        </div>
      </div>
      <div class="wrapper">
        <div class="reserve">
          <form action="/reservation" method="post">
            <label for="">予約日*</label>
            <input
              type="date"
              name="reserve_day"
              min="2000-01-01"
              max="2099-12-31"
              required
            />

            <label for="">開始時間*</label>
            <input type="time" name="start_time" id="time_input" required />

            <label for="">利用時間*(クーポン適応前価格: <span id="priceDisplay">0円</span>)</label>
            <input type="number" name="usage_time" id="timeInput" min="1" required />

            <label for="">内容選択*</label>
            <select name="resource" required>
              <option value="massage">マッサージ</option>
              <option value="cook">調理</option>
            </select>

            <label for="">クーポンコード(クーポンページから入力)</label>
            <input type="text" name="coupon" />

            <label for="">使用ポイント数(使用可能ポイント数: <%= users.point %> P)</label>
            <input type="text" name="point" min="0" max="<%= users.point %>" />

            <label for="">備考</label>
            <input type="textarea" name="memo" />

            <input
              type="submit"
              value="予約する"
              onsubmit="return confirm('予約します。よろしいですか？');"
            />
            <% if(couponError === -1){ %>
            <p>クーポンコードが無効です</p>
            <% }else if(couponError === -2){ %>
            <p>開始日または終了日が無効です</p>
            <% }else if(couponError === -3){ %>
            <p>サービスが使用不可です</p>
            <% } %> <% if (couponError) { %>
            <p class="error">このクーポンは利用できません</p>
            <% } %>
            <h3>※クーポンとポイントの併用はできません</h3>
          </form>
        </div>
        <div class="information">
          <div class="userNewsList">
            <div class="newsTop">
              <h3>お知らせ</h3>
            </div>
            <div class="newsContents">
              <ul>
                <% const today = new Date(); %> <% if (news !== undefined) { %>
                <% news.forEach(item => { %> <% const deadline = new
                Date(item.finish_date); const dateCheck = today <= deadline; %>
                <% if(dateCheck){ %>
                <li>
                  <strong><%= item.name %></strong><br />
                  <small><%= item.contents %></small>
                </li>
                <% }})} %>
              </ul>
            </div>
          </div>
          <div class="reserveList">
            <div class="reservationTop">
              <h3>予約一覧</h3>

              <form class="monthSelect" action="/top" method="get">
                <input type="month" name="month" value="<%= selectedMonth %>" />
                <button type="submit">表示</button>
              </form>
            </div>
            <div class="reservationContents">
              <table>
                <thead>
                  <tr>
                    <th>予約日</th>
                    <th>開始時刻</th>
                    <th>利用時間</th>
                    <th>状態</th>
                  </tr>
                </thead>
                <tbody>
                  <% reservation.forEach(reserve => { %> <% if(reserve.user_id
                  === id){ %> <% const reserveday = new
                  Date(reserve.reserve_day); const format = (d) =>
                  `${d.getFullYear()}/${String(d.getMonth()+1).padStart(2,'0')}/${String(d.getDate()).padStart(2,'0')}`;
                  %>
                  <tr>
                    <td><%= format(reserveday) %></td>
                    <td><%= reserve.start_time.slice(0,5) %></td>
                    <td><%= reserve.usage_time %>分</td>
                    <td><%= reserve.status %></td>
                  </tr>
                  <% }}) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
    <script>
      const timeInput = document.getElementById("timeInput");
      const priceDisplay = document.getElementById("priceDisplay");
      
      const hamburger = document.getElementById("hamburger");
      const nav = document.getElementById("nav");
      const wrapper = document.getElementById("userAllWrapper");

      // 予約日と開始時間を取得
      const reserveDay = document.querySelector('input[name="reserve_day"]');
      const startTime = document.querySelector('input[name="start_time"]');

      // 今日を取得
      const today = new Date().toISOString().split("T")[0];
      reserveDay.min = today;

      // 利用時間入力で価格を計算して表示
      timeInput.addEventListener("change", () => {
        const time = timeInput.value;
        const price = (time/10) * 115; 

        priceDisplay.textContent = price + '円';
      })

      // ハンバーガークリックで開閉
      hamburger.addEventListener("click", (e) => {
        e.stopPropagation(); // 伝播防止
        nav.classList.toggle("active");
      });

      // メニュー内どこをクリックしても閉じる
      wrapper.addEventListener("click", (e) => {
        if (e.target.tagName.toLowerCase() !== "a") {
          nav.classList.remove("active");
        }
      });

      // 今日の場合だけ「現在時刻以降」に制限
      function updateMinTime() {
        if (reserveDay.value !== today) {
          startTime.min = "";
          return;
        }

        const now = new Date();
        const hh = String(now.getHours()).padStart(2, "0");
        const mm = String(now.getMinutes()).padStart(2, "0");
        const currentTime = `${hh}:${mm}`;

        startTime.min = currentTime;

        // すでに入っている時刻が過去なら強制リセット
        if (startTime.value && startTime.value < currentTime) {
          startTime.value = "";
        }
      }

      // 日付変更時
      reserveDay.addEventListener("change", updateMinTime);

      // 時刻入力時
      startTime.addEventListener("change", updateMinTime);
    </script>
  </body>
</html>
