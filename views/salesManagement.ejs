<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <title>予約管理システム</title>
    <!-- レスポンシブ対応用 -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, user-scalable=no"
    />
    <link rel="stylesheet" href="/public/style.css" />
    <link
      rel="stylesheet"
      href="https://maxcdn.bootstrapcdn.com/font-awesome/4.3.0/css/font-awesome.min.css"
    />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
      /* salesManagement 固有レイアウト調整 */
      .salesContents {
        display: flex;
        gap: 16px;
        align-items: stretch;
        align-content: stretch;
      }
      .salesContents .left {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        gap: 16px;
      }
      .salesContents .right {
        width: 360px; /* 必要に応じて調整 */
        flex: 0 0 360px;
      }
      .salesGraph {
        /* グラフ領域を縦に伸ばす */
        flex: 1 1 auto;
        display: flex;
        min-height: 300px; /* 最低高さ */
      }
      .salesGraph canvas {
        width: 100% !important;
        height: 100% !important;
        display: block;
      }
      /* テーブルなどが縦に伸びすぎる場合の制限 */
      .serviceRank table, .userRank table {
        max-height: calc(100vh - 300px);
        overflow: auto;
        display: block;
      }

      /* 計画売上設定のスタイル */
      .monthPrint {
        margin-bottom: 20px;
      }

      /* スマホ対応 */
      @media (max-width: 768px) {
        .monthPrint > div {
          flex-direction: column !important;
          align-items: flex-start !important;
        }

        .monthPrint > div > div:first-child {
          flex-direction: column !important;
          align-items: flex-start !important;
          width: 100%;
        }

        .monthPrint h3 {
          margin-bottom: 12px !important;
        }

        .monthPrint form,
        .monthPrint > div > div:last-child {
          width: 100%;
        }

        #targetInput {
          width: 80px !important;
          font-size: 14px;
        }

        #saveTargetBtn {
          font-size: 14px;
          padding: 6px 10px !important;
        }
      }
    </style>
  </head>
  <body>
    <div>
      <!-- パスワードをお忘れの方への写真 -->
      <%- include("header") %>
      <div class="allwrapper">
        <div class="time">
          <h2>売上管理</h2>
          <div class="time-right">
            <h4>
              <% if (users && users.updated_at) { %>
                <%= new Date(users.updated_at).toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo' }) %> 時点
              <% } else { %>
                --:--:-- 時点
  <% } %>
</h4>
          </div>
        </div>

        <fieldset class="monthPrint">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
            <div style="display: flex; gap: 16px; align-items: center;">
              <h3 style="margin: 0;"><%= Number(selectedMonth.split('-')[1]) %>月売上詳細</h3>
              <form method="GET" action="/salesManagement" style="display: flex; gap: 8px; align-items: center;">
                <input
                  type="month"
                  name="month"
                  min="2000-01-01"
                  max="2099-12-31"
                  value="<%= selectedMonth %>"
                />
                <button type="submit">表示</button>
              </form>
            </div>
            <div style="display: flex; gap: 8px; align-items: center;">
              <label for="targetInput" style="white-space: nowrap;">計画売上:</label>
              <input 
                type="number" 
                id="targetInput" 
                placeholder="目標金額"
                value="<%= targetAmount || '' %>"
                style="width: 120px; padding: 4px 8px;"
                min="0"
              />
              <span>円</span>
              <button type="button" id="saveTargetBtn" style="padding: 6px 12px; cursor: pointer;">設定</button>
            </div>
          </div>
        </fieldset>
        <div class="salesContents">
          <div class="left">
            <fieldset class="sales">
              <% if (ranking.length === 0){ %>
              <h3>まだデータがありません</h3>
              <% }else{ %>
              <table>
                <thead>
                  <tr>
                    <th>今月の売上</th>
                    <th>前月比</th>
                    <th>目標達成率</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>￥<%= totalSales.toLocaleString() %></td>
                    <td>
                      <% 
                        // 前月比の計算: (今月 - 前月) / 前月 * 100
                        let monthOverMonth = 0;
                        if (prevTotalSales > 0) {
                          monthOverMonth = Math.floor(((totalSales - prevTotalSales) / prevTotalSales) * 100);
                        } else if (totalSales > 0) {
                          monthOverMonth = 100; // 前月が0で今月に売上がある場合
                        }
                      %>
                      <%= monthOverMonth >= 0 ? '+' : '' %><%= monthOverMonth %>%
                    </td>
                    <td>
                      <% 
                        // 目標達成率の計算
                        let achievementRate = 0;
                        if (targetAmount > 0) {
                          achievementRate = Math.floor((totalSales / targetAmount) * 100);
                        }
                        
                        // 達成率に応じて色を変更
                        let rateColor = '#000';
                        if (achievementRate >= 100) {
                          rateColor = '#00b300'; // 緑
                        } else if (achievementRate >= 80) {
                          rateColor = '#ff8c00'; // オレンジ
                        } else if (achievementRate > 0) {
                          rateColor = '#ff0000'; // 赤
                        }
                      %>
                      <% if (targetAmount > 0) { %>
                        <span style="color: <%= rateColor %>; font-weight: bold;">
                          <%= achievementRate %>%
                        </span>
                      <% } else { %>
                        <span style="color: #999;">未設定</span>
                      <% } %>
                    </td>
                  </tr>
                </tbody>
              </table>
              <% } %>
            </fieldset>
            <fieldset class="salesGraph">
              <% if (ranking.length === 0){ %>
              <h3>まだデータがありません</h3>
              <% }else{ %>
              <div style="position: relative; width: 100%; height: 100%; min-height: 300px;">
                <canvas id="salesChart"></canvas>
              </div>
              <% } %>
            </fieldset>
          </div>
          <div class="right">
            <fieldset class="serviceRank">
              <% if (ranking.length === 0){ %>
              <h3>まだデータがありません</h3>
              <% }else{ %>
              <h3>サービス別ランキング</h3>
              <table>
                <thead>
                  <tr>
                    <th>順位</th>
                    <th>項目</th>
                    <th>売上</th>
                    <th>構成比</th>
                  </tr>
                </thead>
                <tbody>
                  <% ranking.forEach((r, index) => {%>
                  <tr>
                    <td><%= index + 1 %></td>
                    <td><%= r.resource_name %></td>
                    <td><%= r.total_amount.toLocaleString() %></td>
                    <td>
                      <%= totalSales ? Math.round((r.total_amount / totalSales)
                      * 100) : 0 %>%
                    </td>
                  </tr>
                  <% }); %>
                </tbody>
              </table>
              <% } %>
            </fieldset>
            <fieldset class="userRank">
              <% if (ranking.length === 0){ %>
              <h3>まだデータがありません</h3>
              <% }else{ %>
              <h3>ユーザー別ランキング</h3>
              <table>
                <thead>
                  <tr>
                    <th>順位</th>
                    <th>項目</th>
                    <th>売上</th>
                    <th>構成比</th>
                  </tr>
                </thead>
                <tbody>
                  <% userRanking.forEach((r, index) => {%>
                  <tr>
                    <td><%= index + 1 %></td>
                    <td><%= r.user_name %></td>
                    <td><%= r.total_amount.toLocaleString() %></td>
                    <td>
                      <%= totalSales ? Math.round((r.total_amount / totalSales)
                      * 100) : 0 %>%
                    </td>
                  </tr>
                  <% }); %>
                </tbody>
              </table>
              <% } %>
            </fieldset>
          </div>
        </div>
      </div>
    </div>

    <script>
      // 日別売上データ（EJS → JS）
      const dailySales = <%- JSON.stringify(dailySales || []) %>;

      // グラフ描画
      if (dailySales.length > 0) {
        const labels = dailySales.map(d => {
          const dt = new Date(d.date);
          return dt.toLocaleDateString('ja-JP', { month: 'numeric', day: 'numeric', timeZone: 'Asia/Tokyo' });
        });

        const data = dailySales.map(d => d.total);
        const users = dailySales.map(d => d.user_names);

        const canvas = document.getElementById("salesChart");
        if (canvas) {
          const ctx = canvas.getContext("2d");

          new Chart(ctx, {
            type: "line",
            data: {
              labels,
              datasets: [
                {
                  label: "利用者",
                  data,
                  tension: 0
                }
              ]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                tooltip: {
                  callbacks: {
                    label: function (context) {
                      const index = context.dataIndex;
                      const value = context.raw;
                      const user = users[index] || "不明";
                      return `${user} / ￥${value.toLocaleString()}`;
                    }
                  }
                }
              },
              scales: {
                x: {
                  title: {
                    display: true,
                    text: "日付"
                  }
                },
                y: {
                  title: {
                    display: true,
                    text: "売上金額"
                  }
                }
              }
            }
          });
        }
      }

      // ハンバーガーメニュー（存在する場合のみ）
      const hamburger = document.getElementById("hamburger");
      const nav = document.getElementById("nav");
      const wrapper = document.getElementById("userAllWrapper");

      if (hamburger && nav) {
        hamburger.addEventListener("click", () => {
          nav.classList.toggle("active");
        });
      }

      if (wrapper && nav) {
        wrapper.addEventListener("click", (e) => {
          if (e.target.tagName.toLowerCase() !== "a") {
            nav.classList.remove("active");
          }
        });
      }

      // 計画売上の保存機能
      const saveTargetBtn = document.getElementById("saveTargetBtn");
      const targetInput = document.getElementById("targetInput");

      if (saveTargetBtn && targetInput) {
        saveTargetBtn.addEventListener("click", async () => {
          const targetAmount = parseInt(targetInput.value) || 0;
          const selectedMonth = "<%= selectedMonth %>";

          if (targetAmount < 0) {
            alert("0以上の金額を入力してください");
            return;
          }

          // ボタンを一時的に無効化
          saveTargetBtn.disabled = true;
          saveTargetBtn.textContent = "保存中...";

          try {
            const response = await fetch("/api/sales-target", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({
                month: selectedMonth,
                target_amount: targetAmount,
              }),
            });

            const result = await response.json();

            if (response.ok) {
              // アラートなしでサイレントにリロード
              location.reload();
            } else {
              alert("エラー: " + (result.error || "保存に失敗しました"));
              saveTargetBtn.disabled = false;
              saveTargetBtn.textContent = "設定";
            }
          } catch (error) {
            console.error("エラー詳細:", error);
            alert("通信エラーが発生しました: " + error.message);
            saveTargetBtn.disabled = false;
            saveTargetBtn.textContent = "設定";
          }
        });
      }
    </script>
  </body>
</html>
